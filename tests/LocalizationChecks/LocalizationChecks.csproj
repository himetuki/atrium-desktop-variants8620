<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../settings/Atrium.Settings/Loc.cs" Link="Loc.cs" />
    <Compile Include="../../settings/Atrium.Settings/LocalizationValidation.cs" Link="LocalizationValidation.cs" />
    <Content Include="../../locales/*.json" Link="locales/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../fixtures/locales/*.json" Link="locales/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
